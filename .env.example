# PostgreSQL connection string used by Drizzle ORM (server-side only)
DATABASE_URL="postgresql://user:password@localhost:5432/yukino_agent_test"

# Directory where execution evidence (screenshots, videos, reports) is stored
OUTPUT_DIR="./outputs"

# Default URL of the system under test (demo target site)
TARGET_URL_DEFAULT="http://127.0.0.1:8200"

# Optional initial LLM configuration; migrated into the default text/vision
# profiles on first settings read. Leave empty to run in pure rule mode.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=

# Extra JSON fields merged into every LLM chat request body, for
# provider-specific switches (model/messages are always ignored). Example
# for hybrid-reasoning models: {"enable_thinking": false}
LLM_EXTRA_BODY=

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
